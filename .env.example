# Copier ce fichier en « .env » dans le même dossier que backup.yml.
# infra-manage le charge automatiquement ; les variables déjà définies dans le shell restent prioritaires.

# URL du Webhook Slack pour les notifications d'état et d'alerte
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Mot de passe pour la base de données Ghost (MySQL)
GHOST_DB_PASSWORD=T@mpusghost+

# Mot de passe pour le dépôt Restic (si non spécifié via restic_password_file)
RESTIC_PASSWORD=your_restic_repository_password
